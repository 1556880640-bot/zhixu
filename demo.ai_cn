# ============================================
# AI原生中文编程 - 完整示例
# ============================================
# 运行: python ai_cn.py run demo.ai_cn
# 导出: python ai_cn.py export demo.ai_cn demo.py
# ============================================

输出("=" * 50)
输出("   AI 原生中文编程  v2.0")
输出("=" * 50)

# ============================================
# 第一部分：基础语法
# 和写 Python 一样自然，但用的是中文
# ============================================

输出("\n[PIN] 1. 基础语法")

# 定义变量（中文变量名完全支持）
用户名 = "小明"
年龄 = 25
输出(f"   用户: {用户名}，年龄: {年龄}")

# 如果/否则
如果 年龄 >= 18:
    输出("   成年人")
否则:
    输出("   未成年人")

# 循环
输出("\n[PIN] 2. 循环")
计数 = 0
当 计数 < 3:
    输出(f"   第 {计数 + 1} 次循环")
    计数 = 计数 + 1

# 定义函数
定义 打招呼(名字):
    返回 f"你好，{名字}！"

输出(f"   {打招呼('世界')}")

# ============================================
# 第二部分：AI 原生功能
# 这才是这套语言真正的价值
# ============================================

输出("\n[PIN] 3. AI 原生功能")

# 加载模型 - 自动检测后端
# 如果有 Ollama，会连 Ollama
# 如果有 OpenAI Key，会连 API
# 如果都没有，用模拟模式
模型 = 加载模型("qwen2.5:7b")

输出("\n[PIN] 4. 模型推理")
结果 = 模型.推理("用一句话解释什么是深度学习")
输出(f"   {结果}")

输出("\n[PIN] 5. 搭建知识库")
搭建知识库("./我的文档")

输出("\n[PIN] 6. 批量处理")
# 循环 + AI 的混合用法
主题列表 = ["人工智能", "机器学习", "深度学习"]
循环 主题 在 主题列表:
    输出(f"\n   处理主题: {主题}")
    回复 = 模型.推理(主题 + "是什么？用一句话回答")
    输出(f"   AI: {回复}")

输出("\n[PIN] 7. 入口程序检测")
如果 入口程序:
    输出("\n[OK] 演示完成！这就是AI原生中文编程。")
    输出("   代码即中文，中文即代码。")
    输出("   无需翻译损耗，AI 直接生成可执行的中文代码。")
