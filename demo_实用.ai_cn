# ============================================
# AI-CN 实用能力展示
# 不需要 AI 模型，调用真实 Python 库
# ============================================
# 运行: python ai_cn.py run demo_实用.ai_cn
# ============================================

输出("=" * 50)
输出("   AI-CN 实用能力展示")
输出("=" * 50)

# ============================================
# 1. 调用真实 Python 库
# 中文语法 + Python 生态，无缝衔接
# ============================================

输出("\n[1/4] 调用真实 Python 库")
引入 json
引入 datetime
从 datetime 引入 timedelta

# 获取当前时间（中文变量名）
今天 = datetime.datetime.now()
输出(f"   当前时间: {今天}")

# ============================================
# 2. 定义类和函数（全中文）
# ============================================

输出("\n[2/4] 定义类和函数")

类 计算器:
    定义 相加(自己, a, b):
        返回 a + b

    定义 统计字数(自己, 文本):
        返回 长度(文本)

    定义 过滤空值(自己, 数据列表):
        结果 = []
        循环 项 在 数据列表:
            如果 项 != 空 与 项 != "":
                结果.追加(项)
        返回 结果

计算 = 计算器()
输出(f"   1 + 2 = {计算.相加(1, 2)}")
输出(f"   统计字数('你好世界') = {计算.统计字数('你好世界')}")

编程语言列表 = ["Python", "", None, "JS", None, "Go"]
输出(f"   过滤前: {编程语言列表}")
输出(f"   过滤后: {计算.过滤空值(编程语言列表)}")

# ============================================
# 3. 数据处理（中文逻辑 + 真实计算）
# ============================================

输出("\n[3/4] 中文变量名 + 数据处理")

# 完全用中文命名变量和处理逻辑
学生成绩 = [
    {"姓名": "张三", "分数": 92},
    {"姓名": "李四", "分数": 78},
    {"姓名": "王五", "分数": 85},
    {"姓名": "赵六", "分数": 63},
]

# 计算平均分
总分数 = 0
循环 学生 在 学生成绩:
    总分数 = 总分数 + 学生["分数"]

平均分 = 总分数 / 长度(学生成绩)
输出(f"   平均分: {平均分}")

# 分类：中文条件逻辑
输出("\n   成绩分类:")
循环 学生 在 学生成绩:
    分数 = 学生["分数"]
    如果 分数 >= 90:
        等级 = "优秀"
    否则如果 分数 >= 80:
        等级 = "良好"
    否则如果 分数 >= 70:
        等级 = "中等"
    否则:
        等级 = "不及格"
    输出(f"   {学生['姓名']}: {分数}分 -> {等级}")

# ============================================
# 4. 文件操作（中文代码读写真实文件）
# ============================================

输出("\n[4/4] 文件操作")

文件名 = "_demo_output.txt"
尝试:
    文件 = 打开(文件名, "w", 编码="utf-8")
    文件.写入("这是由AI中文编程生成的文件\n")
    文件.写入(f"生成时间: {今天}\n")
    文件.写入(f"平均分: {平均分}\n")
    文件.关闭()
    输出(f"   文件已写入: {文件名}")

    # 读取回来
    文件 = 打开(文件名, "r", 编码="utf-8")
    内容 = 文件.读取()
    文件.关闭()
    输出(f"   读取内容:\n{内容}")

捕获 Exception 传入 e:
    输出(f"   文件操作失败: {e}")

最终:
    引入 os
    os.移除(文件名)
    输出(f"   临时文件已删除")

# ============================================
# 总结
# ============================================

输出("=" * 50)
输出("   展示完毕！关键点总结：")
输出("   - 中文语法（如果/否则/循环/定义/类）")
输出("   - 中文变量名（学生成绩/总分数/平均分）")
输出("   - 调用真实 Python 库（json/datetime/os）")
输出("   - 中文 + Python 生态完全互通")
输出("=" * 50)
